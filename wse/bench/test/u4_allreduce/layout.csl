// Stage-0c test kernel U4 (written by the modeller before any measurement): 2D allreduce with <collectives_2d>.
// Every PE holds COUNT floats; reduce_fadds along x to column P-1, broadcast along x from P-1, then reduce_fadds
// along y to row P-1 and broadcast along y from P-1.  Every PE ends with the global sum.
param P: u16;
param COUNT: u16;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = P, .height = P });
const c2d = @import_module("<collectives_2d/params>");
layout {
  @set_rectangle(P, P);
  var px: u16 = 0;
  while (px < P) : (px += 1) {
    const memcpy_params = memcpy.get_params(px);
    var py: u16 = 0;
    while (py < P) : (py += 1) {
      const c2d_params = c2d.get_params(px, py, .{
        .x_colors      = .{ @get_color(0),          @get_color(1) },
        .x_entrypoints = .{ @get_local_task_id(14), @get_local_task_id(15) },
        .y_colors      = .{ @get_color(4),          @get_color(5) },
        .y_entrypoints = .{ @get_local_task_id(16), @get_local_task_id(17) },
      });
      @set_tile_code(px, py, "pe.csl", .{ .memcpy_params = memcpy_params, .c2d_params = c2d_params, .COUNT = COUNT });
    }
  }
  @export_name("v", [*]f32, true);
  @export_name("tot", [*]f32, true);
  @export_name("time_buf_u16", [*]u16, true);
  @export_name("main", fn()void);
  @export_name("f_enable_timer", fn()void);
  @export_name("f_memcpy_timestamps", fn()void);
}
