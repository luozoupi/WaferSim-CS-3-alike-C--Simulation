param memcpy_params;
param px: u16;
param py: u16;
param Pw: u16;
param Ph: u16;
param DIR: u16;
param send_e: color;
param recv_w: color;
param send_s: color;
param recv_n: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

const iq_w: input_queue = @get_input_queue(2);
const iq_n: input_queue = @get_input_queue(3);
const oq_e: output_queue = @get_output_queue(2);
const oq_s: output_queue = @get_output_queue(3);
const w_id: data_task_id = if (@is_arch("wse2")) @get_data_task_id(recv_w) else @get_data_task_id(iq_w);
const n_id: data_task_id = if (@is_arch("wse2")) @get_data_task_id(recv_n) else @get_data_task_id(iq_n);

var buf = @zeros([2048]f32);                 // h2d target of the host sequence under test
var ptr_buf: [*]f32 = &buf;

const has_w = DIR == 0 and px > 0;
const has_n = DIR == 1 and py > 0;
// stamps: [round][0 entry, 1 from-west arrival, 2 from-north arrival] x 3 u16 words
var st = @zeros([18]u16);
var tmp = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([18]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;
var round: u16 = 0;          // launches entered
var nw: u16 = 0;             // arrivals from west (the k-th belongs to round k)
var nn: u16 = 0;
var done_round: u16 = 0;     // rounds whose cmd stream has been unblocked

const out_e = @get_dsd(fabout_dsd, .{ .fabric_color = send_e, .extent = 1, .output_queue = oq_e });
const out_s = @get_dsd(fabout_dsd, .{ .fabric_color = send_s, .extent = 1, .output_queue = oq_s });

fn put(slot: u16) void {
  timestamp.get_timestamp(&tmp);
  st[3 * slot] = tmp[0]; st[3 * slot + 1] = tmp[1]; st[3 * slot + 2] = tmp[2];
}
fn try_finish() void {
  // a round is complete when this PE has entered it and received its west/north wavelets for it
  if (done_round < round and (!has_w or nw > done_round) and (!has_n or nn > done_round)) {
    done_round += 1;
    sys_mod.unblock_cmd_stream();
  }
}
fn main() void {
  put(3 * round);
  round += 1;
  if (DIR == 0 and px + 1 < Pw) @mov32(out_e, @as(u32, round));
  if (DIR == 1 and py + 1 < Ph) @mov32(out_s, @as(u32, round));
  try_finish();
}
task from_w(w: u32) void { if (nw < 2) put(3 * nw + 1); nw += 1; try_finish(); }
task from_n(w: u32) void { if (nn < 2) put(3 * nn + 2); nn += 1; try_finish(); }

fn f_enable_timer() void {
  timestamp.enable_tsc();
  sys_mod.unblock_cmd_stream();
}
fn f_memcpy_timestamps() void {
  for (@range(u16, 18)) |i| { time_buf_u16[i] = st[i]; }
  sys_mod.unblock_cmd_stream();
}

comptime {
  if (DIR == 0) {
    @bind_data_task(from_w, w_id);
    if (@is_arch("wse3")) { @initialize_queue(iq_w, .{ .color = recv_w }); @initialize_queue(oq_e, .{ .color = send_e }); }
  } else {
    @bind_data_task(from_n, n_id);
    if (@is_arch("wse3")) { @initialize_queue(iq_n, .{ .color = recv_n }); @initialize_queue(oq_s, .{ .color = send_s }); }
  }
  @export_symbol(ptr_buf, "buf");
  @export_symbol(ptr_time_buf_u16, "time_buf_u16");
  @export_symbol(main);
  @export_symbol(f_enable_timer);
  @export_symbol(f_memcpy_timestamps);
}
